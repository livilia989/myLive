# ─────────────────────────────────────────────
# 선택점쟁이 backend 환경변수
# 이 파일을 복사해 backend/.env 로 저장해서 사용하세요. (.env 는 git 에 올라가지 않습니다)
# ─────────────────────────────────────────────

API_PORT=8787
# 여러 개면 쉼표로 구분
CORS_ORIGIN=http://localhost:5173

# true  : Mock LLM 사용 (API 키 · 비용 없이 전체 흐름 테스트)
# false : OpenAI 호환 API 사용 (아래 LLM_* 설정)
USE_MOCK_LLM=true

# ── OpenAI 호환 API ─────────────────────────────
# 무료: 로컬 Ollama (https://ollama.com) 의 OpenAI 호환 엔드포인트
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
# Ollama 는 API 키가 필요 없습니다. 유료 API 를 쓸 때만 입력하세요. (절대 frontend 에 넣지 마세요)
LLM_API_KEY=
# 로컬 CPU 에서 소형 모델은 응답에 1분 이상 걸릴 수 있습니다
LLM_TIMEOUT_MS=180000
# true 면 규칙 기반(Mock) 초안을 LLM 에게 함께 전달해 소형 로컬 모델의 정확도를 높입니다.
LLM_USE_RULE_DRAFT=true
